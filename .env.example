# Copie para .env e ajuste para seu ambiente local.
# .env esta no .gitignore — nao commite.

# JWT (obrigatorio) — gere com: openssl rand -base64 64
JWT_SECRET=

# Postgres (defaults do docker-compose para dev local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agenda_inteligente

# NFS-e Manaus (opcional — apenas se for emitir nota)
NFSE_MANAUS_AMBIENTE=homologacao
NFSE_CERTIFICADO_PATH=
NFSE_CERTIFICADO_SENHA=
NFSE_USAR_ASSINATURA=false

# Pagamento (opcional — apenas se usar Stripe)
PAYMENT_PROVIDER=stripe
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Endpoint temporario de correcao de admin (deixe vazio em prod normal)
FIX_ADMIN_KEY=
