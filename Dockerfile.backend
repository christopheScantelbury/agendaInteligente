# Multi-stage build — backend para Railway e docker-compose local.
FROM maven:3.9-eclipse-temurin-21 AS build

WORKDIR /app

# Copia tudo em um unico COPY . .
# Qualquer mudanca em qualquer arquivo de fonte invalida esta camada.
# As dependencias Maven sao mantidas via BuildKit cache mount (nao via camada Docker),
# o que evita o problema de caching incorreto de camadas anteriores.
COPY . .

# BuildKit cache mount para ~/.m2/repository:
# - persiste dependencias entre builds (nao faz download toda vez)
# - NAO cria camada Docker (portanto nao fica cacheado como layer)
# - a etapa COPY . . acima e sempre executada com fontes frescas
RUN --mount=type=cache,id=maven-repo,target=/root/.m2/repository \
    mkdir -p /root/.m2 && \
    cp /app/maven-settings.xml /root/.m2/settings.xml && \
    mvn clean package -DskipTests

# Runtime
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

RUN apk add --no-cache wget tzdata \
    && cp /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime \
    && echo "America/Sao_Paulo" > /etc/timezone \
    && addgroup -S spring && adduser -S spring -G spring

USER spring:spring

COPY --from=build /app/target/*.jar app.jar

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/actuator/health || exit 1

EXPOSE 8080

ENTRYPOINT ["java", \
  "-XX:+UseContainerSupport", \
  "-XX:MaxRAMPercentage=70.0", \
  "-XX:InitialRAMPercentage=50.0", \
  "-XX:MaxMetaspaceSize=160m", \
  "-XX:ReservedCodeCacheSize=64m", \
  "-XX:+UseSerialGC", \
  "-XX:+AlwaysActAsServerClassMachine", \
  "-XX:+ExitOnOutOfMemoryError", \
  "-Dfile.encoding=UTF-8", \
  "-Duser.timezone=America/Sao_Paulo", \
  "-Djava.security.egd=file:/dev/./urandom", \
  "-jar", \
  "app.jar"]
