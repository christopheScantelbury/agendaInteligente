# Multi-stage build — backend para Railway e docker-compose local.
FROM maven:3.9-eclipse-temurin-21 AS build

WORKDIR /app

# 1) Dependencias: layer cacheada enquanto pom.xml nao mudar.
COPY pom.xml maven-settings.xml ./
RUN mkdir -p /root/.m2 && \
    cp maven-settings.xml /root/.m2/settings.xml && \
    mvn dependency:go-offline -B -q

# 2) Fonte: layer invalidada quando QUALQUER arquivo em src/ muda.
#    Sem depender de build args, tokens manuais ou variaveis do Railway.
COPY src/ ./src/

RUN mvn package -DskipTests -q

# Runtime
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

RUN apk add --no-cache wget tzdata \
    && cp /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime \
    && echo "America/Sao_Paulo" > /etc/timezone \
    && addgroup -S spring && adduser -S spring -G spring

USER spring:spring

COPY --from=build /app/target/*.jar app.jar

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/actuator/health || exit 1

EXPOSE 8080

ENTRYPOINT ["java", \
  "-XX:+UseContainerSupport", \
  "-XX:MaxRAMPercentage=70.0", \
  "-XX:InitialRAMPercentage=50.0", \
  "-XX:MaxMetaspaceSize=160m", \
  "-XX:ReservedCodeCacheSize=64m", \
  "-XX:+UseSerialGC", \
  "-XX:+AlwaysActAsServerClassMachine", \
  "-XX:+ExitOnOutOfMemoryError", \
  "-Dfile.encoding=UTF-8", \
  "-Duser.timezone=America/Sao_Paulo", \
  "-Djava.security.egd=file:/dev/./urandom", \
  "-jar", \
  "app.jar"]
